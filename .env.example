# =============================================================================
# Chaldea — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env with real secrets to the repository.
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_HOST=mysql
DB_DATABASE=mydatabase
DB_USERNAME=myuser
DB_PASSWORD=change-me-db-password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=change-me-rmq-user
RABBITMQ_DEFAULT_PASS=change-me-rmq-password

# --- JWT ---
# REQUIRED in every environment, including local dev (FEAT-169).
# docker-compose.yml no longer supplies a public fallback: with this key
# unset or empty, user-service refuses to start and logs a RuntimeError
# (and without user-service nothing that checks a JWT works).
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars

# --- Internal service-to-service auth ---
# Single shared secret for all server-to-server calls, sent as the
# `X-Internal-Token` header and checked by `verify_internal_token`
# (fail-closed: unset/empty -> 503, wrong value -> 401).
# Consumed by 13 services: user, character-attributes, skills, inventory,
# character, locations, notification, battle, celery-worker, autobattle,
# battle-pass, dungeon, party.
# dev  (docker-compose.yml): a default value is supplied, so a fresh clone
#      still comes up without this key.
# prod (docker-compose.prod.yml): REQUIRED — every consumer declares
#      `${INTERNAL_SERVICE_TOKEN:?...}`, so the stack refuses to start
#      without it instead of running on a publicly known value.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-at-least-32-chars

# --- S3 / Backblaze B2 (photo-service) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_BUCKET_NAME=your-bucket-name
S3_REGION=eu-central-003

# --- CORS ---
# Comma-separated list of allowed origins. Use * for development.
# Production example: https://fallofgods.top
CORS_ORIGINS=*

# --- Domain (used in nginx) ---
DOMAIN=fallofgods.top
