# The frontend is built outside this image (in CI, or by deploy-prod.sh as a
# fallback) and dropped into docker/api-gateway/frontend-dist before the build.
# Building it here, on the 4 GB VPS, took ~30 minutes per deploy.
FROM nginx:alpine
COPY docker/api-gateway/frontend-dist /usr/share/nginx/html
COPY docker/api-gateway/nginx.prod.conf /etc/nginx/nginx.conf
EXPOSE 80 443
